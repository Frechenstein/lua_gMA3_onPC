-- 20_patch_z300

function Patch_Z300(count)
    ----------------------------------------------------------------
    -- 1) In den Patch wechseln
    ----------------------------------------------------------------
    Cmd("ChangeDestination Root")
    Cmd("ChangeDestination 'ShowData'.'Patch'")

    local patch = Patch()
    if not patch or not patch.FixtureTypes then
        Printf("Patch oder FixtureTypes nicht gefunden.")
        Cmd("ChangeDestination Root")
        return
    end

    ----------------------------------------------------------------
    -- 2) Z300-FixtureType finden
    ----------------------------------------------------------------
    local ftPool = patch.FixtureTypes
    local ft = nil

    for i = 1, #ftPool do
        local fType = ftPool[i]
        if fType
           and fType.Manufacturer
           and fType.Manufacturer:match("Cameo")
           and (
                (fType.Name     and fType.Name:match("Auro"))
             or (fType.LongName and fType.LongName:match("Auro"))
           )
        then
            ft = fType
            break
        end
    end

    if not ft then
        Printf("Kein FixtureType 'Cameo Auro ...' im Showfile. Bitte importieren.")
        Cmd("ChangeDestination Root")
        return
    end

    local mode = ft.DMXModes["20 channel"]
    if not mode then
        Printf("Mode '20 channel' nicht gefunden.")
        Cmd("ChangeDestination Root")
        return
    end

    ----------------------------------------------------------------
    -- 3) In Stage 1 → Fixtures wechseln
    ----------------------------------------------------------------
    Cmd("ChangeDestination Stages")
    Cmd("ChangeDestination 1")
    Cmd("ChangeDestination Fixtures")

    ----------------------------------------------------------------
    -- 4) Patch-Parameter
    ----------------------------------------------------------------
    local universe      = 1
    local startAddress  = 1      -- 1.001
    local footprintStep = 20     -- 20ch Mode
    local startFID      = 101

    ----------------------------------------------------------------
    -- 5) Patchen
    ----------------------------------------------------------------
    for i = 1, count do
        local fid  = startFID + (i - 1)
        local addr = startAddress + (i - 1) * footprintStep
        local name = "Z300 " .. i

        local t = {}
        t.mode   = mode
        t.amount = 1
        t.fid    = tostring(fid)
        t.idtype = "Fixture"
        t.name   = name
        t.patch  = { string.format("%d.%03d", universe, addr) }
        t.undo   = "Lua Patch Z300 " .. i

        local ok = AddFixtures(t)

        if ok ~= nil then
            Printf(string.format(
                "OK: %s  FID %d  @ %d.%03d",
                name, fid, universe, addr
            ))
        else
            Printf("FEHLER beim Patchen von " .. name)
        end
    end

    Cmd("ChangeDestination Root")
end
